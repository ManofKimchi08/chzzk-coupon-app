# 치지직 Open API Client Credentials (네이버 치지직 개발자 센터에서 발급)
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret
CHZZK_REDIRECT_URI=http://localhost:8000/auth/chzzk/callback

# 시뮬레이션(Mock) 테스트 로그인 활성화 여부 (운영 서비스 시 false 설정 권장)
ENABLE_MOCK_LOGIN=true

# 관리자(진행자) 설정
# 1) 스트리머의 치지직 채널 ID (치지직 로그인 시 자동으로 관리자 인식)
ADMIN_CHANNEL_ID=sample_streamer_channel_id

# 2) 관리자 전용 비밀번호 로그인 (/admin 로그인용)
ADMIN_PASSWORD=streamer123!

# 세션 비밀키 (실제 운영 시 무작위 난수로 변경 권장)
SECRET_KEY=chzzk_event_secret_key_2026_super_secure
